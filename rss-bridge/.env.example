# Copy to .env and fill in. Real environment variables (e.g. from systemd)
# win over this file. An explicitly empty value (KEY=) counts as set.

# Base URL of the Obsidian service. No trailing slash needed.
OBSIDIAN_URL=https://xxxxxxyz.xyz/obsidian

# Service key (xyzk_...) with scope obsidian:feed, minted at /auth/account.html.
# Required unless AUTH_TOKEN_URL is empty.
OBSIDIAN_SERVICE_KEY=

# Where the service key is exchanged for a short-lived bearer token.
# Unset: https://xxxxxxyz.xyz/auth/token
# Set to empty (AUTH_TOKEN_URL=): no token exchange and no Authorization header,
# for a local auth-off service.
#AUTH_TOKEN_URL=https://xxxxxxyz.xyz/auth/token

# Feed source name pushed to the server (^[a-z0-9][a-z0-9_-]{0,31}$). Default: wechat
#FEED_SOURCE=wechat

# The wx CLI binary. Default: wx (looked up on PATH)
#WX_BIN=wx

# Maximum articles per `wx biz-articles` run (-n). Default: 200000. A warning is
# logged when a result has exactly this many articles (the window was truncated).
#WX_LIMIT=200000

# How far back a roster scan (the server asks for it with `roster`) looks for
# distinct accounts, in 30-day slices. Default: 365
#ROSTER_LOOKBACK_DAYS=365

# Lookback when the frame has no usable `since`, and for --once/--dry-run without
# --since-days. Default: 7
#FEED_LOOKBACK_DAYS=7

# Kill `wx` after this many seconds. Default: 120
#WX_TIMEOUT_SECONDS=120
